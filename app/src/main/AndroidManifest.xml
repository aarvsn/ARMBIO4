<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required permissions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- OpenGL ES 2.0 required -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- Touchscreen feature -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Accelerometer -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <!-- Main game Activity -->
        <activity
            android:name=".Bio4PreActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|layoutDirection|locale"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTop"
            android:immersive="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Video player Activity for FMV cutscenes -->
        <activity
            android:name=".Bio4VideoActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:screenOrientation="landscape"
            android:theme="@style/VideoTheme"
            android:exported="false" />

        <!-- OSS Licenses Activity -->
        <activity
            android:name=".OssLicensesActivity"
            android:exported="false"
            android:label="@string/oss_licenses_title"
            android:theme="@style/AppTheme" />

    </application>

</manifest>
